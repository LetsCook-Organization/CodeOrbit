{
  "name": "codeorbit",
  "version": "0.2.0",
  "private": true,
  "description": "CodeOrbit: a free study tracker for developers. These are development tools only: the app itself needs no install or build.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.4"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:quick": "node scripts/test.mjs --quick",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
